

void disconnectWiFi() {
	bannerinfo("Disconnect wifi..");
	ArduinoOTA.end();
	wsControl.disconnect();
	WiFi.disconnect(true);  // ล้าง config ด้วย
	WiFi.mode(WIFI_OFF);    // ปิดวิทยุทั้งหมด
	esp_wifi_stop();        // ปิด Wi-Fi stack
}
String jsonStr = "";
DeserializationError error;
StaticJsonDocument<128> doc;
static void onControlEvent(WStype_t type, uint8_t* payload, size_t length) {
	switch (type) {
		case WStype_DISCONNECTED:
			break;
		case WStype_CONNECTED:
			break;
		case WStype_TEXT:
			jsonStr = String((char*)payload);
			error = deserializeJson(doc, jsonStr);
			if (error) {
				Serial.println("❌ JSON parsing failed!");
				break;
			}
			VOLUME = doc["V"];
			if (doc["P"] > 0)
				vzstatus = true;
			else
				vzstatus = false;
			num1Files = doc["01"];
			num2Files = doc["02"];
			if (MainmenuIndex == 2)
				cleantft = true;
			break;
		case WStype_ERROR:
		case WStype_FRAGMENT_TEXT_START:
		case WStype_FRAGMENT_BIN_START:
		case WStype_FRAGMENT:
		case WStype_FRAGMENT_FIN:
			break;
	}
}

